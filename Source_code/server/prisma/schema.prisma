generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  USER
}

model MilkSupplier {
  id        String       @id @default(uuid())
  name      String
  rate      Decimal      @db.Decimal(10, 2)
  records   MilkRecord[]
  payments  SupplierPayment[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model SupplierPayment {
  id          String       @id @default(uuid())
  supplierId  String
  supplier    MilkSupplier @relation(fields: [supplierId], references: [id])
  amount      Decimal      @db.Decimal(10, 2)
  date        DateTime     @default(now())
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum Shift {
  MORNING
  EVENING
}

model MilkRecord {
  id         String       @id @default(uuid())
  supplierId String
  supplier   MilkSupplier @relation(fields: [supplierId], references: [id])
  quantity   Decimal      @db.Decimal(10, 2)
  fat        Decimal      @db.Decimal(10, 2)
  clr        Decimal?     @default(0) @db.Decimal(10, 2)
  snf        Decimal?     @default(0) @db.Decimal(10, 2)
  fatKg      Decimal      @db.Decimal(10, 2)
  snfKg      Decimal      @db.Decimal(10, 2)
  rate       Decimal      @default(0) @db.Decimal(10, 2)
  amount     Decimal      @db.Decimal(10, 2)
  date       DateTime
  shift      Shift
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model MilkSaleRecord {
  id            String         @id @default(uuid())
  purchaserName String         @default("Cash")
  quantity      Decimal        @db.Decimal(10, 2)
  fat           Decimal        @db.Decimal(10, 2)
  clr           Decimal?       @default(0) @db.Decimal(10, 2)
  snf           Decimal?       @default(0) @db.Decimal(10, 2)
  fatKg         Decimal        @db.Decimal(10, 2)
  snfKg         Decimal        @db.Decimal(10, 2)
  rate          Decimal        @default(10) @db.Decimal(10, 2)
  amount        Decimal        @db.Decimal(10, 2)
  date          DateTime
  shift         Shift
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id])
  paymentStatus PaymentStatus  @default(PAID)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Product {
  id          String        @id @default(uuid())
  name        String        @unique
  defaultRate Decimal       @db.Decimal(10, 2)
  unit        String        @default("Kg")
  sales       ProductSale[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ProductSale {
  id            String         @id @default(uuid())
  productId     String
  product       Product        @relation(fields: [productId], references: [id])
  purchaserName String         @default("Cash")
  quantity      Decimal        @db.Decimal(10, 2)
  rate          Decimal        @db.Decimal(10, 2)
  amount        Decimal        @db.Decimal(10, 2)
  date          DateTime
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id])
  paymentStatus PaymentStatus  @default(PAID)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Customer {
  id           String           @id @default(uuid())
  name         String
  mobile       String?
  address      String?
  milkSales    MilkSaleRecord[]
  productSales ProductSale[]
  payments     CustomerPayment[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model CustomerPayment {
  id          String   @id @default(uuid())
  amount      Decimal
  date        DateTime
  description String?
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum PaymentStatus {
  PAID
  PENDING
}
